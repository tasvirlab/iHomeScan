    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt shown by iOS before scanning",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iHomeScan uses the camera for room scans. Photo Scan keeps the photos and silent videos you take in a draft on this device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iHomeScan использует камеру для сканирования комнат. Photo Scan сохраняет снятые фото и видео без звука в черновике на этом устройстве."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iHomeScan kameradan xonani skanerlash uchun foydalanadi. Photo Scan olingan rasmlar va ovozsiz videolarni shu qurilmadagi draftda saqlaydi."
          }
        }
      }
    }
  },
  "version" : "1.0"
