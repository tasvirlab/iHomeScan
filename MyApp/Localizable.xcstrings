    "scanner.tip1": {
      "comment": "Scanning tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your iPhone at chest height."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonni koʻkrak balandligida tuting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите iPhone на уровне груди."
          }
        }
      }
    },
    "scanner.tip2": {
      "comment": "Scanning tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk slowly along the walls."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Devorlar boʻylab sekin yuring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно идите вдоль стен."
          }
        }
      }
