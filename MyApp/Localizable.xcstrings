    "scanner.tip3": {
      "comment": "Scanning tip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture doors and windows too, with good lighting."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eshik va derazalarni ham qamrab oling, xona yorugʻ boʻlsin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захватите двери и окна, при хорошем освещении."
          }
        }
      }
    },
