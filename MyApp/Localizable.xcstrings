    "scanner.unsupported.body": {
      "comment": "Scanner state: device not supported",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room scanning needs an iPhone or iPad with a LiDAR Scanner, such as an iPhone Pro model."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xonani skanerlash uchun LiDAR skanerli iPhone yoki iPad kerak, masalan iPhone Pro modellari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканирования нужен iPhone или iPad со сканером LiDAR, например iPhone Pro."
          }
        }
      }
    },
    "scanner.unsupported.note": {
      "comment": "Hint under unsupported state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still add rooms and measurements manually in any project."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Istalgan loyihada xonalar va oʻlchovlarni qoʻlda kiritishingiz mumkin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
