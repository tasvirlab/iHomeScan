    "scanner.denied.body": {
      "comment": "Scanner state: denied",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan rooms, turn on camera access in Settings → iHomeScan → Camera."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xonalarni skanerlash uchun Sozlamalar → iHomeScan → Kameraʼda ruxsatni yoqing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сканировать комнаты, включите доступ: Настройки → iHomeScan → Камера."
          }
        }
      }
    },
    "scanner.denied.title": {
      "comment": "Scanner state: denied",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraga ruxsat berilmagan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере выключен"
          }
        }
      }
    },
    "scanner.error.body": {
      "comment": "Scanner state: unexpected error",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t check whether the scanner is ready. Please try again."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaner tayyorligini tekshirib boʻlmadi. Qayta urinib koʻring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить готовность сканера. Попробуйте ещё раз."
          }
        }
      }
    },
