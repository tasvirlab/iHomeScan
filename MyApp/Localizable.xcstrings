    "scanner.permission.allow": {
      "comment": "Button that shows the system camera prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraga ruxsat berish"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ к камере"
          }
        }
      }
    },
    "scanner.permission.body": {
      "comment": "Explanation before the system camera prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iHomeScan uses the camera and LiDAR Scanner only while you scan, to measure walls, doors and windows."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iHomeScan kamera va LiDAR skaneridan faqat skanerlash vaqtida devorlar, eshiklar va derazalarni oʻlchash uchun foydalanadi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iHomeScan использует камеру и сканер LiDAR только во время сканирования, чтобы измерить стены, двери и окна."
          }
        }
      }
    },
    "scanner.permission.note": {
      "comment": "Privacy note before the camera prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera images are not saved. Everything stays on this device."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tasvirlari saqlanmaydi. Hammasi shu qurilmada qoladi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения с камеры не сохраняются. Всё остаётся на этом устройстве."
          }
        }
      }
    },
    "scanner.permission.title": {
      "comment": "Scanner state: permission not yet asked",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access needed"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraga ruxsat kerak"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к камере"
          }
        }
      }
    },
    "scanner.ready.body": {
      "comment": "Scanner state: ready",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device supports LiDAR room scanning and camera access is allowed."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qurilma LiDAR orqali xonani skanerlashni qoʻllab-quvvatlaydi va kameraga ruxsat berilgan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство поддерживает LiDAR-сканирование, доступ к камере разрешён."
          }
        }
      }
    },
    "scanner.ready.stageNote": {
      "comment": "Note in ready state",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanning engine will be connected in the next update (Stage 2.2). Nothing is captured or saved yet."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanerlash dvigateli keyingi yangilanishda (Stage 2.2) ulanadi. Hozircha hech narsa yozib olinmaydi va saqlanmaydi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модуль сканирования будет подключён в следующем обновлении (Stage 2.2). Пока ничего не записывается и не сохраняется."
          }
        }
      }
    },
    "scanner.ready.title": {
      "comment": "Scanner state: ready",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to Scan"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanerlashga tayyor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово к сканированию"
          }
        }
      }
    },
    "scanner.restricted.body": {
      "comment": "Scanner state: restricted",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera use is blocked on this device, for example by Screen Time or a device management profile. Ask the person who manages this device to allow it."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qurilmada kameradan foydalanish cheklangan, masalan Ekran vaqti yoki qurilma boshqaruvi profili orqali. Qurilmani boshqaruvchi shaxsdan ruxsat soʻrang."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера заблокирована на этом устройстве, например «Экранным временем» или профилем управления. Обратитесь к тому, кто управляет устройством."
          }
        }
      }
    },
    "scanner.restricted.title": {
      "comment": "Scanner state: restricted",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is restricted"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameradan foydalanish cheklangan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере ограничен"
          }
        }
      }
    },
    "scanner.retry": {
      "comment": "Button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qayta urinish"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        }
      }
    },
    "scanner.simulator.body": {
      "comment": "Scanner state: running in Simulator",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iOS Simulator has no camera or LiDAR Scanner. Run iHomeScan on a LiDAR iPhone to scan rooms."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS simulyatorida kamera va LiDAR skaneri yoʻq. Xonalarni skanerlash uchun iHomeScanʼni LiDARʼli iPhoneʼda ishga tushiring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В симуляторе iOS нет камеры и сканера LiDAR. Запустите iHomeScan на iPhone с LiDAR, чтобы сканировать комнаты."
          }
        }
      }
    },
    "scanner.simulator.title": {
      "comment": "Scanner state: running in Simulator",
