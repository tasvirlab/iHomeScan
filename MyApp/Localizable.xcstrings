    "plan.notScanned.body": {
      "comment": "Plan area placeholder body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A floor plan will appear here after scanning. You can also add rooms and measurements manually."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanerlangandan soʻng reja shu yerda paydo boʻladi. Xonalar va oʻlchovlarni qoʻlda ham kiritishingiz mumkin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План появится здесь после сканирования. Комнаты и размеры можно также добавить вручную."
          }
        }
      }
    },
