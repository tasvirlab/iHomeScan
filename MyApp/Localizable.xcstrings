    "error.generic": {
      "comment": "Generic error",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatolik yuz berdi. Qayta urinib koʻring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте ещё раз."
          }
        }
      }
    },
    "error.invalidMeasurement": {
      "comment": "Validation error",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurements must be positive numbers"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻlchovlar musbat son boʻlishi kerak"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размеры должны быть положительными числами"
          }
        }
      }
    },
    "error.lastFloor": {
      "comment": "Error when deleting the only floor",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project needs at least one floor"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyihada kamida bitta qavat boʻlishi kerak"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В проекте должен быть хотя бы один этаж"
          }
        }
      }
    },
    "error.storage.body": {
      "comment": "Database failed to open",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data has not been changed. Please restart the app; if this continues, contact support."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maʼlumotlaringiz oʻzgartirilmadi. Ilovani qayta ishga tushiring; muammo davom etsa, qoʻllab-quvvatlash xizmatiga murojaat qiling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные не изменены. Перезапустите приложение; если проблема повторится, обратитесь в поддержку."
          }
        }
      }
    },
    "error.storage.title": {
      "comment": "Database failed to open",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data can’t be opened"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal maʼlumotlarni ochib boʻlmadi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть локальные данные"
          }
        }
      }
    },
