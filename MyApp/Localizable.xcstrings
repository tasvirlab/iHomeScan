    "floor.delete.message": {
      "comment": "Floor delete confirmation; floor name, localized room count",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (%2$@) and everything in it will be permanently deleted from this device."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (%2$@) va undagi barcha maʼlumotlar ushbu qurilmadan butunlay oʻchiriladi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» (%2$@) и все данные в нём будут удалены с устройства без возможности восстановления."
          }
        }
      }
    },
    "floor.delete.title": {
      "comment": "Confirmation title",
