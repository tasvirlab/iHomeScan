    "plan.error.body": {
      "comment": "Plan load error body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan file is missing or damaged. Room data is not affected."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Reja fayli yoʻq yoki shikastlangan. Xonalar maʼlumotlariga taʼsir qilmaydi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл плана отсутствует или повреждён. Данные комнат не затронуты."
          }
        }
      }
